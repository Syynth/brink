{
  "name": "brink-book-ts-check",
  "private": true,
  "type": "module",
  "description": "Type-checks the book's TypeScript examples against the published @brink-lang packages.",
  "scripts": {
    "extract": "node extract.mjs",
    "check": "node extract.mjs && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@brink-lang/editor": "0.8.1",
    "@brink-lang/web": "0.9.0",
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "5.7.3"
  }
}
