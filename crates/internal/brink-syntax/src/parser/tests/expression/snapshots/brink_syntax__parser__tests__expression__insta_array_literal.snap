    ASSIGNMENT@2..16
      PATH@2..3
        IDENT@2..3 "x"
      WHITESPACE@3..4 " "
      EQ@4..5 "="
      WHITESPACE@5..6 " "
      ARRAY_LITERAL@6..16
        HASH@6..7 "#"
        L_BRACKET@7..8 "["
        INTEGER_LIT@8..9
