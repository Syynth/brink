{
	"packageManager": "pnpm@10.34.5",
	"scripts": {
		"release": "pnpm --filter @brink-lang/web build && pnpm --filter @brink-lang/studio build && pnpm changeset publish",
		"check:grammar-drift": "node scripts/check-grammar-drift.mjs",
		"check:pnpm-pin": "node scripts/check-pnpm-pin.mjs",
		"check:scripts": "node scripts/check-scripts.mjs",
		"check:wasm-pkg": "node scripts/check-wasm-pkg.mjs",
		"install:checked": "node scripts/guarded-install.mjs",
		"test:scripts": "node --test scripts/*.test.mjs",
		"test:setup-dev": "bash scripts/setup-dev.test.sh",
		"test:refresh-lockfiles": "bash scripts/refresh-excluded-lockfiles.test.sh"
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3"
	}
}
