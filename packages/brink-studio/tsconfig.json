{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    // A copy of ./alias-map.ts's studioTsconfigPaths() — JSON cannot import,
    // so this is the one shape that stays hand-maintained. Guarded from
    // inside this package by src/__tests__/alias-map.test.ts (#2464), and
    // against packages/brink-desktop/alias-map.ts by
    // packages/brink-desktop/src/__tests__/playground-alias-parity.test.ts
    // (#2450) — an entry added, removed, or repointed here without a
    // matching update turns both suites red.
    "paths": {
      "brink-web": ["../../crates/brink-web/www/pkg"],
      "@brink/wasm-types": ["../wasm-types/src/index.ts"],
      "@brink-lang/web": ["../wasm/src/index.ts"],
      "@brink/ink-operations": ["../ink-operations/src/index.ts"],
      "@brink-lang/dialect": ["../dialect/src/index.ts"],
      "@brink-lang/editor": ["../ink-editor/src/index.ts"],
      "@brink/studio-shell": ["../studio-shell/src/index.ts"],
      "@brink/studio-store": ["../studio-store/src/index.ts"],
      "@brink/studio-ui": ["../studio-ui/src/index.ts"]
    }
  },
  "include": ["src"]
}
