{
  // This package's BUILD-TOOLING program (#2464).
  //
  // tsconfig.json's "include" is ["src"], so the six modules below were
  // checked by `tsc` only as a side effect of @brink/desktop's program
  // importing three of them (PR #2460) — tsup.config.ts and
  // playwright.config.ts by nothing at all. `pnpm --filter
  // @brink-lang/studio typecheck` now runs this program as well, so the
  // coverage is this package's own rather than an external consumer's
  // accident.
  //
  // "include" must list EVERY root-level .ts/.mts/.cts module: that is
  // asserted against the directory listing by src/__tests__/alias-map.test.ts
  // (#2494), so a config module added as any of those extensions cannot
  // quietly go unchecked.
  //
  // These files are node, not browser: "types": ["node"] is what makes
  // `__dirname` and `import { resolve } from "path"` resolve, and naming it
  // explicitly (rather than leaving @types auto-discovery to it) keeps this
  // program's globals from depending on what else happens to be installed.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": [
    "alias-map.ts",
    "playwright.config.ts",
    "vite.config.ts",
    "vite.config.embed.ts",
    "vitest.config.ts",
    "tsup.config.ts",
    "*.mts",
    "*.cts"
  ]
}
