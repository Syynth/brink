{
  "name": "@brink-lang/studio",
  "version": "0.18.0",
  "description": "Embeddable brink studio — a full ink IDE (CodeMirror editor, compiler diagnostics, story player, binder, story graph) mounted into a DOM element with one call.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/Syynth/brink",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Syynth/brink.git",
    "directory": "packages/brink-studio"
  },
  "bugs": {
    "url": "https://github.com/Syynth/brink/issues"
  },
  "keywords": [
    "ink",
    "narrative",
    "interactive-fiction",
    "ide",
    "editor",
    "react"
  ],
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsup",
    "build:embed": "vite build --config vite.config.embed.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:perf": "playwright test --config playwright.perf.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.e2e.json",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@brink-lang/web": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@brink-lang/editor": "workspace:*",
    "@brink/ink-operations": "workspace:*",
    "@brink/studio-shell": "workspace:*",
    "@brink/studio-store": "workspace:*",
    "@brink/studio-ui": "workspace:*",
    "@brink/wasm-types": "workspace:*",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "brink-prose": "file:../../crates/brink-prose/www/pkg",
    "codemirror": "^6.0.1",
    "jsdom": "^29.0.0",
    "markdown-to-jsx": "^7.7.17",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "zustand": "^5.0.15"
  }
}
