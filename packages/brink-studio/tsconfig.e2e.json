{
  // This package's E2E test program (#2607).
  //
  // `tsconfig.json`'s "include" is ["src"], so the e2e/*.spec.ts files were
  // typechecked by nothing — only transformed at run time by Playwright's
  // esbuild-based loader. This program ensures e2e specs are typechecked
  // alongside the other two programs (tsconfig.json and tsconfig.node.json).
  //
  // The playwright.config.ts references these specs but does not cause them
  // to be checked — that configuration sets up the e2e runner but carries no
  // type information about spec content. The specs are independently checked
  // by this program, then executed by Playwright's own loader.
  //
  // "include" must list the e2e directory and may list any config modules
  // (like playwright.config.ts) that are used by e2e but not already checked.
  // This is asserted against the directory listing by
  // src/__tests__/alias-map.test.ts (#2607), so the coverage is validated
  // against what actually exists on disk.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@playwright/test", "node"]
  },
  "include": ["e2e", "playwright.config.ts"]
}
