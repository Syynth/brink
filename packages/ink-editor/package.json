{
  "name": "@brink-lang/editor",
  "version": "0.17.0",
  "description": "The brink ink-language CodeMirror 6 editor: syntax-aware extensions, inline rename, code actions, folding, completions, project search, and per-view document sessions for building an ink IDE in the browser.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/Syynth/brink",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Syynth/brink.git",
    "directory": "packages/ink-editor"
  },
  "bugs": {
    "url": "https://github.com/Syynth/brink/issues"
  },
  "keywords": [
    "ink",
    "narrative",
    "interactive-fiction",
    "editor",
    "codemirror"
  ],
  "sideEffects": [
    "**/color-widget.*"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@brink-lang/dialect": "workspace:^",
    "@brink-lang/web": "workspace:^",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.7.0",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.1",
    "@replit/codemirror-indentation-markers": "^6.5.3",
    "codemirror": "^6.0.1"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@brink/ink-operations": "workspace:*",
    "@brink/wasm-types": "workspace:*",
    "jsdom": "^29.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
