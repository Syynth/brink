{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brink Studio",
  "version": "0.1.0",
  "identifier": "dev.brink.studio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "pnpm build",
    "beforeBundleCommand": "node scripts/assert-real-sidecar.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Brink Studio",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/brink-cli"
    ],
    "fileAssociations": [
      {
        "ext": ["ink", "brink"],
        "name": "Brink Story",
        "description": "Ink/Brink interactive-fiction source",
        "role": "Editor"
      }
    ]
  }
}