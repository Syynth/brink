{
  "name": "@brink/desktop",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "description": "Tauri desktop shell for brink-studio (docs/desktop-shell-spec.md, D1)",
  "scripts": {
    "dev": "node scripts/ensure-wasm.mjs && node scripts/ensure-cli-sidecar.mjs && vite",
    "build": "node scripts/ensure-cli-sidecar.mjs && vite build",
    "stage:universal": "node scripts/ensure-cli-sidecar.mjs --universal",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
    "@brink-lang/editor": "workspace:*",
    "@brink-lang/studio": "workspace:*",
    "@brink-lang/web": "workspace:*",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^29.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}