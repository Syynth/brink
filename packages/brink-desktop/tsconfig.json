{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    // `scripts/*.mjs` are plain ESM with JSDoc, not TypeScript. `allowJs`
    // (without `checkJs`) is what lets a test `import` one and get inferred
    // types rather than TS7016 — needed since #2452 gave
    // `ensure-cli-sidecar.mjs` an export seam its test calls directly.
    "allowJs": true,
    "types": ["vite/client", "node"],
    "paths": {
      "brink-web": ["../../crates/brink-web/www/pkg"],
      "@brink-lang/web": ["../wasm/src/index.ts"],
      "@brink-lang/studio": ["../brink-studio/src/index.ts"],
      "@brink/wasm-types": ["../wasm-types/src/index.ts"],
      "@brink/ink-operations": ["../ink-operations/src/index.ts"],
      "@brink-lang/editor": ["../ink-editor/src/index.ts"],
      "@brink/studio-shell": ["../studio-shell/src/index.ts"],
      "@brink/studio-store": ["../studio-store/src/index.ts"],
      "@brink/studio-ui": ["../studio-ui/src/index.ts"]
    }
  },
  "include": ["src"]
}
